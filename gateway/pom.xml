<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.demo.ticketing</groupId>
    <artifactId>ticketing-platform</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <artifactId>gateway</artifactId>
  <packaging>jar</packaging>
  <name>gateway</name>

  <dependencies>
    <dependency>
      <groupId>org.springframework.cloud</groupId>
      <artifactId>spring-cloud-starter-gateway</artifactId>
    </dependency>
    <!-- Bridges Spring Cloud Gateway's CircuitBreaker filter onto Resilience4j (reactive).
         The gateway filter needs a ReactiveCircuitBreakerFactory, which the plain
         resilience4j-spring-boot3 dependency below does NOT provide on its own. -->
    <dependency>
      <groupId>org.springframework.cloud</groupId>
      <artifactId>spring-cloud-starter-circuitbreaker-reactor-resilience4j</artifactId>
    </dependency>
    <!-- Gives us the `resilience4j.*` configuration-property binding (configs/instances),
         so breaker + time limiter settings live in application.yml, not in Java. -->
    <dependency>
      <groupId>io.github.resilience4j</groupId>
      <artifactId>resilience4j-spring-boot3</artifactId>
    </dependency>
    <!-- Edge JWT validation. Reactive (WebFlux) resource server; HS256/HS512 shared-secret
         decoder is built in GatewayJwtConfig. No jjwt here on purpose: the gateway only
         *validates*, it never signs. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <!-- Structured JSON console logs (root CLAUDE.md: "Structured JSON logs everywhere"), consumed
         by the Elastic/Kibana log stack. 7.4 is the last line explicitly compatible across
         Logback 1.2/1.3/1.4/1.5.x without a hard floor above our managed 1.5.12 (Spring Boot
         3.3.6 BOM), so it avoids a NoSuchMethodError risk that newer 8.x releases (which require
         logback-classic >= 1.5.13) could hit. -->
    <dependency>
      <groupId>net.logstash.logback</groupId>
      <artifactId>logstash-logback-encoder</artifactId>
      <version>7.4</version>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Local stub backend for route tests: no Docker/Testcontainers needed at the edge.
         Version comes from the Spring Boot BOM's okhttp-bom import. -->
    <dependency>
      <groupId>com.squareup.okhttp3</groupId>
      <artifactId>mockwebserver</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
